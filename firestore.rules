rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/tasks/{taskId} {
      function owner() { return request.auth != null && request.auth.uid == userId; }
      function valid() {
        let d = request.resource.data;
        return d.keys().hasAll(['title','course','done','createdAt'])
          && d.keys().hasOnly(['title','course','done','createdAt'])
          && d.title is string && d.title.size() > 0 && d.title.size() <= 120
          && d.course is string && d.course.size() > 0 && d.course.size() <= 60
          && d.done is bool && d.createdAt is timestamp;
      }
      allow read, delete: if owner();
      allow create: if owner() && valid() && request.resource.data.createdAt == request.time;
      allow update: if owner() && valid() && request.resource.data.createdAt == resource.data.createdAt;
    }
  }
}
